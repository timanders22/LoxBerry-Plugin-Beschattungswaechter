#!/bin/sh
#
# Beschattungswaechter - alle fuenf Minuten.
#
# Der Lauf entscheidet SELBST, ob er etwas tut: nur wenn eingeschaltet, nur im
# Zeitfenster und nur, wenn der eingestellte Abstand vergangen ist. Deshalb
# steht hier der kurze Takt und nicht der stuendliche - die Entscheidung
# gehoert in das Plugin, nicht in den Cron-Ordner, sonst muesste man beim
# Aendern des Abstands eine Datei verschieben.
#
# Der Platzhalter in der Zeile LAUF= wird bei der Installation durch den
# bin-Ordner des Plugins ersetzt. Deshalb steht hier KEIN fester Systempfad
# und auch keine Rechnung mit ".." vom eigenen Ablageort aus: LoxBerry legt
# diese Datei drei Ebenen unter der Wurzel ab, eine solche Rechnung landete
# daneben - und der Cron liefe still ins Leere.
#
# WARUM cron.05min UND NICHT cron.15min: die erste Fassung lag in cron.15min.
# Diesen Ordner benutzt in dieser Anlage KEIN anderes Plugin - und die 0.9.0
# hatte dort versehentlich einen Unterordner angelegt (cron/cron.15min war ein
# Verzeichnis statt einer Datei). Beim Update lag dieser Ordner der Datei im
# Weg, und der Cron lief eine Stunde lang nicht. cron.05min dagegen traegt in
# dieser Anlage fuenf Plugins, die nachweislich laufen.
LAUF="REPLACELBPBINDIR/bw_lauf.php"
#
# DIE FEHLERAUSGABE GEHT NACH cron.err (C5, Durchgang 30.09.2026; Bauform
# Docker NG 1.3.7 und Abfahrts-Assistent 1.6.10). LoxBerry ruft jede
# Cron-Datei mit "> /dev/null 2>&1" auf (am Geraet gelesen in
# /etc/cron.d/lbdefaults). Der Platzhalter in der Zeile ERR= wird bei der
# Installation durch den Protokollordner des Plugins ersetzt. Ab 256 kB auf die
# letzten 300 Zeilen gekappt - log/ liegt im Arbeitsspeicher. Der Reiter
# Logdateien zeigt die Datei, sobald etwas darin steht.
ERR="REPLACELBPLOGDIR/cron.err"
#
# SEIT 0.9.31 (Gruppe 23, B15; Bauform Abfahrt 1.6.32 / Ferien 1.2.29 plus
# Root-Abwurf wie Docker NG 1.3.20):
#   - ALS ROOT VON HAND GESTARTET, wird an loxberry abgegeben (su, dash-tauglich);
#     gibt es den Benutzer nicht, laeuft nichts und nichts wird als root
#     angelegt. Ein Handlauf als root legte bis 0.9.30 cron.err und lauf.lock
#     root-eigen an - danach startete php nicht mehr (cron.err nicht
#     beschreibbar) bzw. sendete der Takt nie wieder (Pruefbericht B15).
#   - Laesst sich cron.err nicht anlegen oder beschreiben (touch scheitert),
#     laeuft php trotzdem, die Fehlerausgabe geht dann mit nach /dev/null.
#   - KEIN flock hier (N9): der Takt startet den Haus-Hoerer per proc_open, und
#     ein Deskriptor dieser Datei ginge an ihn ueber (bis 420 s) und sperrte den
#     naechsten Takt (Gedaechtnis "Sperre vererbt sich an Kinder"). Die
#     PHP-Sperre lauf.lock reicht.
if [ "$(id -u 2>/dev/null)" = "0" ]; then
    if id loxberry >/dev/null 2>&1; then
        exec su -s /bin/sh loxberry -c "\"$0\""
    fi
    echo "Beschattungswaechter: als root gestartet, einen Benutzer loxberry gibt es nicht - der Takt laeuft nicht." >&2
    exit 1
fi

[ -f "$LAUF" ] || exit 0
mkdir -p "$(dirname "$ERR")" 2>/dev/null
if touch "$ERR" 2>/dev/null; then
    if [ "$(wc -c < "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -n 300 "$ERR" > "$ERR.neu" 2>/dev/null && mv -f "$ERR.neu" "$ERR"
    fi
    /usr/bin/php "$LAUF" >/dev/null 2>>"$ERR"
else
    /usr/bin/php "$LAUF" >/dev/null 2>&1
fi
exit 0
